# Environment Variables Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/hospital_management
DB_USERNAME=hospital_user
DB_PASSWORD=change_this_password

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-min-256-bits-change-this-immediately
JWT_EXPIRATION=86400000

# Server Configuration
SERVER_PORT=8080

# Email Configuration (for notifications)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@hospital.com

# SMS Configuration (Twilio example)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# File Upload
UPLOAD_DIR=./uploads/medical-documents
MAX_FILE_SIZE=10MB

# Redis Configuration (for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Security
ACCOUNT_LOCKOUT_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=1800000
PASSWORD_EXPIRY_DAYS=90

# Business Rules
BUSINESS_HOURS_START=08:00
BUSINESS_HOURS_END=18:00
MIN_ADVANCE_BOOKING_HOURS=2
MAX_ADVANCE_BOOKING_DAYS=90
DEFAULT_APPOINTMENT_DURATION=30

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/hospital-management.log
